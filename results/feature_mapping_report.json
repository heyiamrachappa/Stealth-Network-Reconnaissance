  "cic_ids_2017_mapping": {
    "flow_duration": {
      "source_col": "Flow Duration",
      "type": "direct",
      "note": "microseconds \u2192 seconds: divide by 1e6"
    },
    "flow_packet_count": {
      "source_col": "Total Fwd Packets+Total Backward Packets",
      "type": "computed",
      "note": "sum fwd+bwd packet counts"
    },
    "flow_bytes": {
      "source_col": "Total Length of Fwd Packets+Total Length of Bwd Packets",
      "type": "computed",
      "note": "sum fwd+bwd byte counts"
    },
    "flow_syn_ratio": {
      "source_col": "SYN Flag Count/flow_packet_count",
      "type": "computed",
      "note": "flag count / total packets"
    },
    "flow_ack_ratio": {
      "source_col": "ACK Flag Count/flow_packet_count",
      "type": "computed",
      "note": "flag count / total packets"
    },
    "flow_rst_ratio": {
      "source_col": "RST Flag Count/flow_packet_count",
      "type": "computed",
      "note": "flag count / total packets"
    },
    "flow_fin_ratio": {
      "source_col": "FIN Flag Count/flow_packet_count",
      "type": "computed",
      "note": "flag count / total packets"
    },
    "flow_size_mean": {
      "source_col": "Packet Length Mean",
      "type": "direct",
      "note": "mean packet size"
    },
    "flow_size_var": {
      "source_col": "Packet Length Variance",
      "type": "direct",
      "note": "variance of packet sizes"
    },
    "flow_interval_mean": {
      "source_col": "Flow IAT Mean",
      "type": "direct",
      "note": "mean inter-arrival time in microseconds"
    },
    "flow_interval_var": {
      "source_col": "Flow IAT Std",
      "type": "approximated",
      "note": "using std^2; CIC reports std not variance"
    },
