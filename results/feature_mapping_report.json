  "unsw_nb15_mapping": {
    "flow_duration": {
      "source_col": "dur",
      "type": "direct",
      "note": "seconds"
    },
    "flow_packet_count": {
      "source_col": "spkts+dpkts",
      "type": "computed",
      "note": "sum of source and destination packet counts"
    },
    "flow_bytes": {
      "source_col": "sbytes+dbytes",
      "type": "computed",
      "note": "sum of source and destination bytes"
    },
    "flow_syn_ratio": {
      "source_col": "state=='SYN' or state=='S0'",
      "type": "approximated",
      "note": "binary: 1.0 if state indicates SYN-only flow, else 0.0"
    },
    "flow_ack_ratio": {
      "source_col": "N/A",
      "type": "unavailable",
      "note": "UNSW-NB15 provides state string, not per-flag counts \u2192 set to 0.0"
    },
    "flow_rst_ratio": {
      "source_col": "state=='RST'",
      "type": "approximated",
      "note": "binary: 1.0 if state=RST, else 0.0"
    },
    "flow_fin_ratio": {
      "source_col": "N/A",
      "type": "unavailable",
      "note": "not distinguishable from state field \u2192 set to 0.0"
    },
    "flow_size_mean": {
      "source_col": "(sbytes+dbytes)/(spkts+dpkts)",
      "type": "computed",
      "note": "total bytes / total packets; approximate mean"
    },
    "flow_size_var": {
      "source_col": "N/A",
      "type": "unavailable",
      "note": "UNSW-NB15 has no per-packet size distribution \u2192 set to 0.0"
    },
    "flow_interval_mean": {
      "source_col": "(sintpkt+dintpkt)/2",
      "type": "approximated",
      "note": "average of mean source and destination inter-packet times"
    },
    "flow_interval_var": {
      "source_col": "N/A",
      "type": "unavailable",
      "note": "UNSW-NB15 provides mean inter-packet time only \u2192 set to 0.0"
    },
